    {
      "tool": {
        "name": "places",
        "title": "Find saved places",
        "description": "Read one page of 20 saved places, optionally filtered locally by name. q is not a server-side search: an empty or short filtered result does NOT mean all pages were searched. Omit q to check page size; paginate unfiltered until a short page. Coordinates identify a bounding box for visits_in_area or points_in_area. The API does not promise stable ordering during changes.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "q": {
              "type": "string",
              "description": "Optional case-insensitive name substring applied only to this page.",
              "minLength": 1,
              "maxLength": 200
