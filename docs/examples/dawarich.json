{
  "formatVersion": 1,
  "id": "app.dawarich",
  "version": "1.0.1",
  "title": "Dawarich",
  "description": "Query your own Dawarich location history: recorded points, detected visits, and saved places. Location results are disclosed to EVA and its configured model. Requires EVA with declarative Bearer credentials and a reachable HTTPS Dawarich server; verified contract: Dawarich 1.14.0.",
  "setup": [
    "Use an EVA release that supports HTTP credentialScheme: bearer; older releases reject this package.",
    "In the installed extension server settings, choose a service name, replace https://dawarich.example.org with your HTTPS origin, and enter the Dawarich API key in Bearer token.",
    "Enable the extension and reconnect the conversation. Keep Tailscale connected on the phone if your server is tailnet-only."
  ],
  "guidance": "Resolve relative dates in the user's timezone and send explicit ISO 8601 offsets. For \"where at time\", compare points just before and after that time and report sample gaps. For a month, use visits across that month, paginate, and distinguish suggested from confirmed visits. Visits may be absent even when imported points exist; fall back to points and report incomplete coverage. For \"last visit to X\", identify X via places, then use a small geographic box with visits_in_area; verify place_id/name and status. Use points_in_area descending if visits are missing. Avoid claiming exact venue identity from coordinates alone. Each request returns at most 20 source records; pagination headers are not available to EVA. Follow pages within the turn budget and state remaining uncertainty. places filters only the fetched page: an empty filtered page is not evidence of absence. No tool writes or triggers geocoding/visit detection.",
  "capabilities": [
    {
      "tool": {
        "name": "points",
        "title": "Location points",
        "description": "Read up to 20 recorded points in an inclusive time range. For location at a time, use a narrow window and compare timestamps; a nearby sample does not prove continuous presence. Coordinates are strings; timestamps are Unix seconds. Excludes points flagged as anomalies. Paginate until a short page; EVA does not expose pagination headers.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "start_at": {
              "type": "string",
              "description": "ISO 8601 timestamp with explicit UTC offset; resolve the user's timezone before calling.",
              "minLength": 20,
              "maxLength": 35
            },
            "end_at": {
              "type": "string",
              "description": "ISO 8601 timestamp with explicit UTC offset; resolve the user's timezone before calling.",
              "minLength": 20,
              "maxLength": 35
            },
            "order": {
              "type": "string",
              "description": "asc for earliest points; desc for latest points.",
              "enum": [
                "asc",
                "desc"
              ]
            },
            "page": {
              "type": "integer",
              "description": "Page number, starting at 1. Request the next page to continue.",
              "minimum": 1,
              "maximum": 100000
            }
          },
          "required": [
            "start_at",
            "end_at"
          ],
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": true
        }
      },
      "effects": "read",
      "execution": {
        "mode": "synchronous",
        "requiresForeground": false,
        "maxWaitMillis": 30000
      },
      "binding": {
        "kind": "http",
        "origin": "https://dawarich.example.org",
        "method": "GET",
        "path": "/api/v1/points",
        "parameters": [
          {
            "name": "start_at",
            "in": "query",
            "value": {
              "argument": "start_at",
              "type": "string",
              "required": true
            }
          },
          {
            "name": "end_at",
            "in": "query",
            "value": {
              "argument": "end_at",
              "type": "string",
              "required": true
            }
          },
          {
            "name": "order",
            "in": "query",
            "value": {
              "argument": "order",
              "type": "string",
              "default": "desc"
            }
          },
          {
            "name": "slim",
            "in": "query",
            "value": {
              "value": true,
              "type": "boolean"
            }
          },
          {
            "name": "page",
            "in": "query",
            "value": {
              "argument": "page",
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "value": {
              "value": 20,
              "type": "integer"
            }
          }
        ],
        "credential": "dawarich",
        "credentialScheme": "bearer",
        "maxResponseBytes": 262144,
        "result": {
          "maxBytes": 15000,
          "items": {
            "line": "id={id} timestamp={timestamp} latitude={latitude} longitude={longitude} country_name={country_name}",
            "fields": {
              "id": {
                "pointer": "/id",
                "type": "integer",
                "required": true
              },
              "timestamp": {
                "pointer": "/timestamp",
                "type": "integer"
              },
              "latitude": {
                "pointer": "/latitude",
                "type": "string"
              },
              "longitude": {
                "pointer": "/longitude",
                "type": "string"
              },
              "country_name": {
                "pointer": "/country_name",
                "type": "string"
              }
            },
            "maxItems": 20,
            "truncationNote": "Output capped. Narrow the range or request another page; this is not an exhaustive history.",
            "arrayPaths": [
              ""
            ]
          }
        }
      }
    },
    {
