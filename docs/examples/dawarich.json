              "minimum": 1,
              "maximum": 100000
            }
          },
          "required": [
            "start_at",
            "end_at"
          ],
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": true
        }
      },
