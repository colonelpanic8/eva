{
  "formatVersion": 1,
  "id": "community.org-agenda",
  "version": "0.2.1",
  "title": "Org agenda",
  "capabilities": [
    {
      "tool": {
        "name": "agenda",
        "title": "Read agenda",
        "description": "Read an agenda span. Results carry references for a later complete_todo request.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "span": {
              "type": "string",
              "enum": [
                "day",
                "week"
              ]
            },
            "date": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10
            },
            "include_overdue": {
              "type": "boolean"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "effects": "read",
      "execution": {
        "mode": "synchronous",
        "requiresForeground": false,
        "maxWaitMillis": 30000
      },
      "binding": {
        "kind": "http",
        "origin": "https://agenda.example.org",
        "method": "GET",
        "path": "/agenda",
        "parameters": [
          {
            "in": "query",
            "name": "span",
            "value": {
              "argument": "span",
              "type": "string",
              "default": "day"
            }
          },
          {
            "in": "query",
            "name": "date",
            "value": {
              "argument": "date",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "include_overdue",
            "value": {
              "argument": "include_overdue",
              "type": "boolean"
            }
          }
        ],
        "credential": "org-agenda",
        "maxResponseBytes": 1048576,
        "result": {
          "maxBytes": 16384,
          "items": {
            "arrayPaths": [
              "/entries",
              "/days/*"
            ],
            "line": "state={state} priority={priority} title={title} scheduled={scheduled} time={scheduledTime} deadline={deadline} time={deadlineTime} tags={tags} id={id} file={file} pos={pos}",
            "fields": {
              "state": {
                "pointer": "/todo",
                "type": "string"
              },
              "priority": {
                "pointer": "/priority",
                "type": "string"
              },
              "title": {
                "pointer": "/title",
                "type": "string",
                "required": true
              },
              "scheduled": {
                "pointer": "/scheduled/date",
                "type": "string"
              },
              "scheduledTime": {
                "pointer": "/scheduled/time",
                "type": "string"
              },
              "deadline": {
                "pointer": "/deadline/date",
                "type": "string"
              },
              "deadlineTime": {
                "pointer": "/deadline/time",
                "type": "string"
              },
              "tags": {
                "pointer": "/tags",
                "type": "stringArray"
              },
              "id": {
                "pointer": "/id",
                "type": "string"
              },
              "file": {
                "pointer": "/file",
                "type": "string"
              },
              "pos": {
                "pointer": "/pos",
                "type": "integer"
              }
            },
            "maxItems": 50,
            "truncationNote": "Not all matching items are shown. Narrow the search or request a smaller agenda span."
          }
        }
      }
    },
    {
      "tool": {
        "name": "search_todos",
        "title": "Search todos",
        "description": "Find todos by text. Preserve returned identifiers when completing an item in a separate user request.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "q": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "q"
          ],
          "additionalProperties": false
        }
      },
      "effects": "read",
      "execution": {
        "mode": "synchronous",
        "requiresForeground": false,
        "maxWaitMillis": 30000
      },
      "binding": {
        "kind": "http",
        "origin": "https://agenda.example.org",
        "method": "GET",
        "path": "/get-all-todos",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "value": {
              "argument": "q",
              "type": "string",
              "required": true
            }
          },
          {
            "in": "query",
            "name": "limit",
            "value": {
              "argument": "limit",
              "type": "integer",
              "default": 20
            }
          }
        ],
        "credential": "org-agenda",
        "maxResponseBytes": 1048576,
        "result": {
          "maxBytes": 16384,
          "items": {
            "arrayPaths": [
              "/todos"
            ],
            "line": "state={state} priority={priority} title={title} scheduled={scheduled} time={scheduledTime} deadline={deadline} time={deadlineTime} tags={tags} id={id} file={file} pos={pos}",
            "fields": {
              "state": {
                "pointer": "/todo",
                "type": "string"
              },
              "priority": {
                "pointer": "/priority",
                "type": "string"
              },
              "title": {
                "pointer": "/title",
                "type": "string",
                "required": true
              },
              "scheduled": {
                "pointer": "/scheduled/date",
                "type": "string"
              },
              "scheduledTime": {
                "pointer": "/scheduled/time",
                "type": "string"
              },
              "deadline": {
                "pointer": "/deadline/date",
                "type": "string"
              },
              "deadlineTime": {
                "pointer": "/deadline/time",
                "type": "string"
              },
              "tags": {
                "pointer": "/tags",
                "type": "stringArray"
              },
              "id": {
                "pointer": "/id",
                "type": "string"
              },
              "file": {
                "pointer": "/file",
                "type": "string"
              },
              "pos": {
                "pointer": "/pos",
                "type": "integer"
              }
            },
            "maxItems": 50,
            "truncationNote": "Not all matching items are shown. Narrow the search or request a smaller agenda span.",
            "totalPointer": "/total"
          }
        }
      }
    },
    {
      "tool": {
        "name": "capture",
        "title": "Capture todo",
        "description": "Create a todo. Template defaults to default; title supplies the Title capture value.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "template": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false
        }
      },
      "effects": "write",
      "execution": {
        "mode": "synchronous",
        "requiresForeground": false,
        "maxWaitMillis": 30000
      },
      "binding": {
        "kind": "http",
        "origin": "https://agenda.example.org",
        "method": "POST",
        "path": "/capture",
        "parameters": [],
        "credential": "org-agenda",
        "maxResponseBytes": 1048576,
        "result": {
          "pointer": "",
          "maxBytes": 4096,
          "evidence": {
            "pointer": "/status",
            "equals": "created"
          }
        },
        "requestBody": {
          "fields": {
            "template": {
              "argument": "template",
              "type": "string",
              "default": "default"
            },
            "values": {
              "fields": {
                "Title": {
                  "argument": "title",
                  "type": "string",
                  "required": true
                }
              }
            }
          }
        }
      }
    },
    {
      "tool": {
        "name": "complete_todo",
        "title": "Complete todo",
        "description": "Complete exactly the entry identified by id, or by file, pos, and exact title from a prior read. Stale references are refused. Search and completion require separate user requests.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "file": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "pos": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "effects": "write",
      "execution": {
        "mode": "synchronous",
        "requiresForeground": false,
        "maxWaitMillis": 30000
      },
      "binding": {
        "kind": "select",
        "argument": "id",
        "present": {
          "kind": "http",
          "origin": "https://agenda.example.org",
          "method": "POST",
          "path": "/complete",
          "parameters": [],
          "credential": "org-agenda",
          "maxResponseBytes": 1048576,
          "result": {
            "pointer": "",
            "maxBytes": 4096,
            "evidence": {
              "pointer": "/status",
              "equals": "completed"
            },
            "notExecutedStatuses": [
              409
            ]
          },
          "requestBody": {
            "fields": {
              "id": {
                "argument": "id",
                "type": "string",
                "required": true
              },
              "strict": {
                "value": true,
                "type": "boolean"
              }
            }
          }
        },
        "absent": {
          "kind": "http",
          "origin": "https://agenda.example.org",
          "method": "POST",
          "path": "/complete",
          "parameters": [],
          "credential": "org-agenda",
          "maxResponseBytes": 1048576,
          "result": {
            "pointer": "",
            "maxBytes": 4096,
            "evidence": {
              "pointer": "/status",
              "equals": "completed"
            },
            "notExecutedStatuses": [
              409
            ]
          },
          "requestBody": {
            "fields": {
              "file": {
                "argument": "file",
                "type": "string",
                "required": true
              },
              "pos": {
                "argument": "pos",
                "type": "integer",
                "required": true
              },
              "title": {
                "argument": "title",
                "type": "string",
                "required": true
              },
              "strict": {
                "value": true,
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "tool": {
        "name": "custom_view",
        "title": "Custom agenda view",
        "description": "Omit key to list available views; supply a returned key to run that view.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "effects": "read",
      "execution": {
        "mode": "synchronous",
        "requiresForeground": false,
        "maxWaitMillis": 30000
      },
      "binding": {
        "kind": "select",
        "argument": "key",
        "present": {
          "kind": "http",
          "origin": "https://agenda.example.org",
          "method": "GET",
          "path": "/custom-view",
          "parameters": [
            {
              "in": "query",
              "name": "key",
              "value": {
                "argument": "key",
                "type": "string",
                "required": true
              }
            }
          ],
          "credential": "org-agenda",
          "maxResponseBytes": 1048576,
          "result": {
            "maxBytes": 16384,
            "items": {
              "arrayPaths": [
                "/entries"
              ],
              "line": "state={state} priority={priority} title={title} scheduled={scheduled} time={scheduledTime} deadline={deadline} time={deadlineTime} tags={tags} id={id} file={file} pos={pos}",
              "fields": {
                "state": {
                  "pointer": "/todo",
                  "type": "string"
                },
                "priority": {
                  "pointer": "/priority",
                  "type": "string"
                },
                "title": {
                  "pointer": "/title",
                  "type": "string",
                  "required": true
                },
                "scheduled": {
                  "pointer": "/scheduled/date",
                  "type": "string"
                },
                "scheduledTime": {
                  "pointer": "/scheduled/time",
                  "type": "string"
                },
                "deadline": {
                  "pointer": "/deadline/date",
                  "type": "string"
                },
                "deadlineTime": {
                  "pointer": "/deadline/time",
                  "type": "string"
                },
                "tags": {
                  "pointer": "/tags",
                  "type": "stringArray"
                },
                "id": {
                  "pointer": "/id",
                  "type": "string"
                },
                "file": {
                  "pointer": "/file",
                  "type": "string"
                },
                "pos": {
                  "pointer": "/pos",
                  "type": "integer"
                }
              },
              "maxItems": 50,
              "truncationNote": "Not all matching items are shown. Narrow the search or request a smaller agenda span."
            }
          }
        },
        "absent": {
          "kind": "http",
          "origin": "https://agenda.example.org",
          "method": "GET",
          "path": "/custom-views",
          "parameters": [],
          "credential": "org-agenda",
          "maxResponseBytes": 1048576,
          "result": {
            "maxBytes": 16384,
            "items": {
              "arrayPaths": [
                "/views"
              ],
              "line": "key={key} name={name}",
              "fields": {
                "key": {
                  "pointer": "/key",
                  "type": "string",
                  "required": true
                },
                "name": {
                  "pointer": "/name",
                  "type": "string",
                  "required": true
                }
              },
              "maxItems": 50,
              "truncationNote": "Not all matching items are shown. Narrow the search or request a smaller agenda span."
            }
          }
        }
      }
    },
    {
      "tool": {
        "name": "open_create",
        "title": "Create through mova",
        "description": "Ask mova to create a todo with the default template. Requires mova to be signed in. This is a handoff, not verified creation.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false
        }
      },
      "effects": "external_handoff",
      "execution": {
        "mode": "handoff",
        "requiresForeground": true,
        "maxWaitMillis": 30000
      },
      "binding": {
        "kind": "android.intent",
        "action": "android.intent.action.VIEW",
        "uri": {
          "base": "mova://create",
          "query": {
            "title": {
              "argument": "title",
              "type": "string",
              "required": true
            }
          }
        }
      }
    }
  ]
}
