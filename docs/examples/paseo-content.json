{
  "formatVersion": 1,
  "id": "example.paseo-content",
  "version": "0.1.0",
  "title": "Paseo content and handoffs",
  "androidPackages": [
    "sh.paseo",
    "sh.paseo.assembly"
  ],
  "capabilities": [
    {
      "tool": {
        "name": "workspaces",
        "title": "List Paseo workspaces",
        "description": "List Paseo workspaces. Returned data is limited to the selected provider response.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "q": {
              "type": "string",
              "maxLength": 200
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "effects": "read",
      "execution": {
        "mode": "synchronous",
        "requiresForeground": false,
        "maxWaitMillis": 10000
      },
      "binding": {
        "kind": "android.content",
        "authority": "sh.paseo.assistant",
        "uri": {
          "base": "content://sh.paseo.assistant/workspaces",
          "query": {
            "q": {
              "argument": "q",
              "type": "string"
            },
            "limit": {
              "argument": "limit",
              "type": "integer"
            }
          }
        },
        "projection": {
          "id": "string",
          "name": "string"
        },
        "maxRows": 20,
        "maxBytes": 8000
      }
    },
    {
      "tool": {
        "name": "agents",
        "title": "List Paseo agents",
        "description": "List Paseo agents. Returned data is limited to the selected provider response.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "workspaceId": {
              "type": "string",
              "maxLength": 200
            },
            "q": {
              "type": "string",
              "maxLength": 200
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "effects": "read",
      "execution": {
        "mode": "synchronous",
        "requiresForeground": false,
        "maxWaitMillis": 10000
      },
      "binding": {
        "kind": "android.content",
        "authority": "sh.paseo.assistant",
        "uri": {
          "base": "content://sh.paseo.assistant/agents",
          "query": {
            "workspaceId": {
              "argument": "workspaceId",
              "type": "string"
            },
            "q": {
              "argument": "q",
              "type": "string"
            },
            "limit": {
              "argument": "limit",
              "type": "integer"
            }
          }
        },
        "projection": {
          "id": "string",
          "name": "string"
        },
        "maxRows": 20,
        "maxBytes": 8000
      }
    },
    {
      "tool": {
        "name": "open_agent",
        "title": "Open Paseo agent",
        "description": "Open Paseo agent. Returned data is limited to the selected provider response.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "agentId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "agentId"
          ],
          "additionalProperties": false
        }
      },
      "effects": "external_handoff",
      "execution": {
        "mode": "handoff",
        "requiresForeground": true,
        "maxWaitMillis": 10000
      },
      "binding": {
        "kind": "android.intent",
        "action": "android.intent.action.VIEW",
        "uri": {
          "base": "paseo://agent",
          "query": {
            "agentId": {
              "argument": "agentId",
              "type": "string"
            }
          }
        }
      }
    }
  ]
}
