{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/colonelpanic8/eva/docs/schemas/index.schema.json",
  "title": "EVA extension repository index",
  "type": "object",
  "required": ["formatVersion", "packages"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": { "const": 1 },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "title", "url", "sha256", "androidPackages"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$" },
          "version": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "url": { "type": "string", "description": "Relative to the index URL or an absolute HTTPS URL on the same origin" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "androidPackages": { "type": "array", "maxItems": 16, "items": { "type": "string" } }
        }
      }
    }
  }
}
