{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/colonelpanic8/eva/docs/schemas/package.schema.json",
  "title": "EVA declarative extension package (formatVersion 1)",
  "description": "One self-contained JSON document, at most 256 KiB, without scripts or credentials. The Kotlin codec in app/src/main/java/com/colonelpanic/eva/adapters/declarative/PackageCodec.kt remains the executable oracle; this schema documents its accepted shape.",
  "type": "object",
  "required": ["formatVersion", "id", "version", "title", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000, "description": "What the package is for, shown before install." },
    "guidance": { "type": "string", "minLength": 1, "maxLength": 1500, "description": "How the package's tools fit together, added to session instructions as attributed external data while any of them is offered." },
    "setup": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "description": "What the user must do outside EVA before the actions work.",
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "androidPackages": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "maxLength": 200 } },
    "capabilities": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/capability" } },
    "settings": {
      "type": "object",
      "maxProperties": 16,
      "description": "User-set, non-secret values that setting slots read. Values live in the user's configuration (packages.settings), never in the package; secrets stay credential references.",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
      "additionalProperties": { "$ref": "#/$defs/setting" }
    },
    "messaging": { "$ref": "#/$defs/messaging" }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "required": ["tool", "binding", "execution"],
      "additionalProperties": false,
      "properties": {
        "tool": { "$ref": "tool.schema.json" },
        "effects": { "enum": ["read", "write", "external_handoff", "unknown"], "description": "Omitted means unknown. Intent bindings floor at external_handoff; non-GET/HEAD HTTP floors at write." },
        "execution": { "$ref": "#/$defs/execution" },
        "binding": { "$ref": "#/$defs/binding" },
        "validators": {
          "type": "object",
          "description": "String argument name to named validator",
          "additionalProperties": { "enum": ["phoneNumber", "httpUrl", "emailAddress"] }
        },
        "receipts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "success": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "handlerMissing": { "type": "string", "minLength": 1, "maxLength": 1000 }
          }
        },
        "_meta": { "type": "object" }
      }
    },
    "execution": {
      "type": "object",
      "required": ["mode", "requiresForeground"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["synchronous", "handoff"], "description": "Intent bindings require handoff plus requiresForeground true; HTTP and content bindings require synchronous." },
        "requiresForeground": { "type": "boolean" },
        "maxWaitMillis": { "type": ["integer", "null"], "minimum": 1, "description": "Capability default wait; the common policy clamps the effective wait to 60,000 ms." },
        "requiresUnlock": { "type": "boolean", "description": "Intent bindings only. On a locked phone showing EVA's screen, EVA asks for the unlock before opening the target; declining opens nothing." },
        "endsVoiceCall": { "enum": ["never", "after_reply", "immediately"], "description": "Whether a successful call ends a voice call: after the model's reply to the result, or immediately without reading it back. Never when omitted. The user may override it." }
      }
    },
    "scalarType": { "enum": ["string", "integer", "number", "boolean"] },
    "argumentSlot": {
      "type": "object",
      "required": ["argument", "type"],
      "additionalProperties": false,
      "properties": {
        "argument": { "type": "string", "maxLength": 64 },
        "type": { "$ref": "#/$defs/scalarType" },
        "default": { "type": ["string", "integer", "number", "boolean"] },
        "required": { "type": "boolean" },
        "values": {
          "type": "object",
          "description": "Bound value per tool enum value; keys must equal the string argument's enum.",
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "literalSlot": {
      "type": "object",
      "required": ["value", "type"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": ["string", "integer", "number", "boolean"] },
        "type": { "$ref": "#/$defs/scalarType" }
      }
    },
    "settingSlot": {
      "type": "object",
      "required": ["setting", "type"],
      "additionalProperties": false,
      "description": "The user's configured value for a declared setting, or its default.",
      "properties": { "setting": { "type": "string", "maxLength": 64 }, "type": { "$ref": "#/$defs/scalarType" } }
    },
    "slot": { "oneOf": [{ "$ref": "#/$defs/argumentSlot" }, { "$ref": "#/$defs/literalSlot" }, { "$ref": "#/$defs/settingSlot" }] },
    "setting": {
      "type": "object",
      "required": ["type", "title"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["string", "integer", "boolean"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "default": { "type": ["string", "integer", "boolean"] },
        "enum": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
        "minLength": { "type": "integer", "minimum": 0, "maximum": 2000 },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "minimum": { "type": "integer" },
        "maximum": { "type": "integer" }
      }
    },
    "textSource": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 100 },
        { "type": "object", "required": ["setting"], "additionalProperties": false, "properties": { "setting": { "type": "string", "maxLength": 64 } } }
      ]
    },
    "messagingLookup": {
      "type": "object",
      "required": ["tool"],
      "additionalProperties": false,
      "properties": { "tool": { "type": "string", "maxLength": 64 }, "query": { "type": "string", "maxLength": 64 }, "limit": { "type": "string", "maxLength": 64 } }
    },
    "messaging": {
      "type": "object",
      "required": ["service", "label", "conversations", "history", "send"],
      "additionalProperties": false,
      "description": "Serve EVA's shared conversation, history, and send tools under a service name. The named tools are reached only through those shared tools.",
      "properties": {
        "service": { "$ref": "#/$defs/textSource" },
        "label": { "$ref": "#/$defs/textSource" },
        "conversations": { "$ref": "#/$defs/messagingLookup" },
        "contacts": { "$ref": "#/$defs/messagingLookup" },
        "history": {
          "type": "object",
          "required": ["tool", "conversation"],
          "additionalProperties": false,
          "properties": { "tool": { "type": "string", "maxLength": 64 }, "conversation": { "type": "string", "maxLength": 64 }, "limit": { "type": "string", "maxLength": 64 } }
        },
        "send": {
          "type": "object",
          "required": ["tool", "conversation", "text"],
          "additionalProperties": false,
          "properties": { "tool": { "type": "string", "maxLength": 64 }, "conversation": { "type": "string", "maxLength": 64 }, "text": { "type": "string", "maxLength": 64 } }
        },
        "startChat": {
          "type": "object",
          "required": ["tool", "recipients", "conversation"],
          "additionalProperties": false,
          "properties": { "tool": { "type": "string", "maxLength": 64 }, "recipients": { "type": "string", "maxLength": 64 }, "conversation": { "$ref": "#/$defs/pointer" } }
        }
      }
    },
    "bodySlot": {
      "description": "Request-body slots may also carry a whole scalar-list argument as a JSON array.",
      "oneOf": [
        { "$ref": "#/$defs/slot" },
        {
          "type": "object",
          "required": ["argument", "type"],
          "additionalProperties": false,
          "properties": {
            "argument": { "type": "string", "maxLength": 64 },
            "type": { "const": "array" },
            "default": { "type": "array", "items": { "type": ["string", "integer", "number", "boolean"] } },
            "required": { "type": "boolean" }
          }
        }
      ]
    },
    "bodyFields": {
      "type": "object",
      "required": ["fields"],
      "additionalProperties": false,
      "properties": {
        "fields": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
          "additionalProperties": { "oneOf": [{ "$ref": "#/$defs/bodyFields" }, { "$ref": "#/$defs/bodySlot" }] }
        }
      }
    },
    "pointer": { "type": "string", "maxLength": 1000, "pattern": "^(|/.*)$" },
    "operation": {
      "type": "object",
      "required": ["header", "status", "outcomes"],
      "additionalProperties": false,
      "description": "A durable server-side operation. EVA sends the header with a key derived from the invocation, reads the status path with {operation} replaced by that key until the state maps to a final outcome, and never resubmits.",
      "properties": {
        "header": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}$" },
        "status": {
          "type": "object",
          "required": ["path", "state"],
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "maxLength": 2000, "pattern": "^/.*\\{operation\\}" },
            "state": { "$ref": "#/$defs/pointer" },
            "detail": { "$ref": "#/$defs/pointer" }
          }
        },
        "outcomes": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "additionalProperties": { "enum": ["completed", "not_executed", "unknown", "pending"] }
        }
      }
    },
    "binding": {
      "oneOf": [
        { "$ref": "#/$defs/select" },
        { "$ref": "#/$defs/intent" },
        { "$ref": "#/$defs/content" },
        { "$ref": "#/$defs/http" }
      ]
    },
    "select": {
      "type": "object",
      "required": ["kind", "argument", "present", "absent"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "select" },
        "argument": { "type": "string", "maxLength": 64 },
        "present": { "oneOf": [{ "$ref": "#/$defs/intent" }, { "$ref": "#/$defs/content" }, { "$ref": "#/$defs/http" }] },
        "absent": { "oneOf": [{ "$ref": "#/$defs/intent" }, { "$ref": "#/$defs/content" }, { "$ref": "#/$defs/http" }] }
      }
    },
    "intentUri": {
      "type": "object",
      "required": ["base"],
      "additionalProperties": false,
      "properties": {
        "base": { "type": "string", "maxLength": 2000, "description": "Fixed and absolute; a content: base admits no slots at all." },
        "query": { "type": "object", "maxProperties": 64, "additionalProperties": { "$ref": "#/$defs/slot" } },
        "opaque": { "$ref": "#/$defs/slot" },
        "path": {
          "type": "object",
          "maxProperties": 64,
          "description": "Slots for {name} placeholders after the scheme in base; each value is percent-encoded whole.",
          "additionalProperties": { "$ref": "#/$defs/slot" }
        }
      }
    },
    "intent": {
      "type": "object",
      "required": ["kind", "action"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "android.intent" },
        "action": {
          "oneOf": [
            { "type": "string", "maxLength": 200, "pattern": "^[A-Za-z][A-Za-z0-9_.]+$" },
            {
              "description": "A string argument slot whose values map covers its enum; every mapped value is an intent action.",
              "$ref": "#/$defs/argumentSlot"
            }
          ]
        },
        "uri": {
          "oneOf": [
            { "$ref": "#/$defs/intentUri" },
            {
              "type": "object",
              "description": "The whole data URI comes from a string argument; only the listed schemes are launched.",
              "required": ["argument", "schemes"],
              "additionalProperties": false,
              "properties": {
                "argument": { "type": "string", "maxLength": 64 },
                "schemes": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "pattern": "^[a-z][a-z0-9+.-]*$" } }
              }
            }
          ]
        },
        "querySpread": {
          "type": "object",
          "required": ["argument"],
          "additionalProperties": false,
          "description": "A string-map argument whose entries become further query parameters; a key equal to a fixed query name is refused.",
          "properties": { "argument": { "type": "string", "maxLength": 64 } }
        },
        "extras": { "type": "object", "maxProperties": 64, "additionalProperties": { "$ref": "#/$defs/slot" } },
        "package": { "type": "string" },
        "class": { "type": "string", "maxLength": 300 },
        "mimeType": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$" },
        "packageByName": { "type": "string" }
      }
    },
    "contentQuery": {
      "type": "object", "maxProperties": 64,
      "propertyNames": { "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$" },
      "additionalProperties": { "$ref": "#/$defs/slot" }
    },
    "content": {
      "type": "object",
      "required": ["kind", "authority", "uri", "projection", "maxRows", "maxBytes"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "android.content" },
        "authority": { "type": "string", "maxLength": 200 },
        "uri": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^content://" },
            {
              "type": "object",
              "required": ["base"],
              "additionalProperties": false,
              "properties": {
                "base": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^content://" },
                "query": { "$ref": "#/$defs/contentQuery" },
                "path": {
                  "type": "object", "maxProperties": 64,
                  "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
                  "additionalProperties": { "$ref": "#/$defs/slot" }
                }
              }
            }
          ]
        },
        "projection": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "additionalProperties": { "enum": ["string", "integer", "number", "boolean", "json"] },
          "description": "A json column decodes a JSON text cell into structured data."
        },
        "selection": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["column", "operator", "value"],
            "additionalProperties": false,
            "properties": {
              "column": { "type": "string", "maxLength": 64 },
              "operator": { "enum": ["=", "!=", "<", "<=", ">", ">=", "LIKE"] },
              "value": { "$ref": "#/$defs/slot" }
            }
          }
        },
        "maxRows": { "type": "integer", "minimum": 1, "maximum": 100 },
        "maxBytes": { "type": "integer", "minimum": 1, "maximum": 16384 }
      }
    },
    "http": {
      "type": "object",
      "required": ["kind", "origin", "method", "path", "parameters", "maxResponseBytes", "result"],
      "additionalProperties": false,
      "dependentRequired": { "credentialScheme": ["credential"] },
      "properties": {
        "kind": { "const": "http" },
        "origin": { "type": "string", "maxLength": 2000, "pattern": "^https://[^/?#@]+$" },
        "method": { "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string", "maxLength": 2000, "pattern": "^/" },
        "parameters": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["in", "name", "value"],
            "additionalProperties": false,
            "properties": {
              "in": { "enum": ["path", "query"] },
              "name": { "type": "string", "maxLength": 64 },
              "value": { "$ref": "#/$defs/slot" }
            }
          }
        },
        "requestBody": { "$ref": "#/$defs/bodyFields" },
        "credential": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
        "credentialScheme": { "enum": ["basic", "bearer"], "default": "basic" },
        "operation": { "$ref": "#/$defs/operation" },
        "maxResponseBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "result": { "$ref": "#/$defs/result" }
      }
    },
    "result": {
      "type": "object",
      "required": ["maxBytes"],
      "additionalProperties": false,
      "description": "Exactly one of pointer or items.",
      "properties": {
        "maxBytes": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "pointer": { "$ref": "#/$defs/pointer" },
        "items": { "$ref": "#/$defs/items" },
        "evidence": {
          "type": "object",
          "required": ["pointer", "equals"],
          "additionalProperties": false,
          "properties": {
            "pointer": { "$ref": "#/$defs/pointer" },
            "equals": { "type": ["string", "integer", "number", "boolean"] }
          }
        },
        "notExecutedStatuses": { "type": "array", "items": { "type": "integer", "minimum": 400, "maximum": 499 } }
      },
      "oneOf": [{ "required": ["pointer"] }, { "required": ["items"] }]
    },
    "items": {
      "type": "object",
      "required": ["arrayPaths", "line", "fields", "maxItems", "truncationNote"],
      "additionalProperties": false,
      "properties": {
        "arrayPaths": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/pointer" } },
        "line": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
          "additionalProperties": {
            "type": "object",
            "required": ["pointer", "type"],
            "additionalProperties": false,
            "properties": {
              "pointer": { "$ref": "#/$defs/pointer" },
              "type": {
                "enum": ["string", "integer", "number", "boolean", "stringArray"],
                "description": "A stringArray field may use one * segment to gather a string from every element it spans, such as /participants/*/name."
              },
              "required": { "type": "boolean" }
            }
          }
        },
        "maxItems": { "type": "integer", "minimum": 1, "maximum": 100 },
        "truncationNote": { "type": "string", "minLength": 1, "maxLength": 500 },
        "totalPointer": { "$ref": "#/$defs/pointer" },
        "filter": {
          "type": "object",
          "required": ["fields", "argument"],
          "additionalProperties": false,
          "properties": {
            "fields": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/pointer" } },
            "argument": { "type": "string", "maxLength": 64 }
          }
        }
      }
    }
  }
}
