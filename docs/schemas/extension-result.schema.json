{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/colonelpanic8/eva/docs/schemas/extension-result.schema.json",
  "title": "EVA extension execute reply (AIDL protocol v1)",
  "description": "EVA's outcome envelope around MCP tool-result content. The whole document is bounded to the capability's declared result.maxBytes (at most 16,384 UTF-8 bytes).",
  "type": "object",
  "required": ["protocolVersion", "status", "reasonCode", "truncated", "content"],
  "additionalProperties": false,
  "properties": {
    "protocolVersion": { "const": 1 },
    "status": { "enum": ["completed", "not_executed", "failed", "handed_off", "unknown"] },
    "reasonCode": {
      "oneOf": [
        { "type": "null" },
        { "enum": ["stale_descriptor", "not_configured", "busy", "invalid_arguments", "unauthorized_caller", "deadline_exceeded"] }
      ]
    },
    "truncated": { "type": "boolean" },
    "content": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["type", "text"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "text" },
          "text": { "type": "string" },
          "_meta": { "type": "object" }
        }
      }
    },
    "structuredContent": { "type": ["object", "null"] },
    "secrets": {
      "description": "Values EVA types into the screen but withholds from the model, journal, and history; sent only when the describe request lists the secrets feature.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,31}$" },
      "additionalProperties": {
        "type": "object",
        "required": ["value", "label"],
        "additionalProperties": false,
        "properties": {
          "value": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "label": { "type": "string", "minLength": 1, "maxLength": 120, "description": "Non-secret description shown to the model and the user." }
        }
      }
    },
    "rejectedCredentials": {
      "description": "Declared credentials whose delivered value the provider found wrong during this call; EVA shows each as rejected on use. Sent only when the describe request lists the credential-check feature.",
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" }
    },
    "_meta": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["completed", "handed_off"] } } },
      "then": { "properties": { "reasonCode": { "type": "null" } } }
    },
    {
      "if": { "properties": { "reasonCode": { "enum": ["stale_descriptor", "not_configured", "busy", "invalid_arguments", "unauthorized_caller"] } } },
      "then": { "properties": { "status": { "const": "not_executed" } } }
    },
    {
      "if": { "properties": { "reasonCode": { "const": "deadline_exceeded" } } },
      "then": { "properties": { "status": { "enum": ["not_executed", "unknown"] } } }
    },
    {
      "if": { "required": ["secrets"] },
      "then": { "properties": { "status": { "const": "completed" } } }
    },
    {
      "if": { "required": ["rejectedCredentials"] },
      "then": { "properties": { "status": { "enum": ["not_executed", "failed"] } } }
    }
  ]
}
