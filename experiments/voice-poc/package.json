{
  "name": "eva-voice-poc",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/browser.ts --bundle --format=esm --outfile=public/app.js",
    "start": "npm run build && tsx src/server.ts",
    "check": "biome check . && tsc --noEmit && tsx --test test/*.test.ts && npm run build",
    "format": "biome check --write .",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/node": "22.18.6",
    "@types/ws": "8.18.1",
    "esbuild": "0.25.10",
    "playwright-core": "1.55.1",
    "tsx": "4.20.6",
    "typescript": "5.9.2"
  }
}
