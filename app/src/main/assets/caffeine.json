{
  "formatVersion": 1,
  "id": "android.caffeine",
  "version": "0.1.0",
  "title": "Caffeine",
  "capabilities": [
    {
      "tool": {
        "name": "enable",
        "description": "Ask Caffeine to keep the screen awake. Uses the installed Caffeine app. State cannot be read back; a successful launch is handoff evidence only.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      },
      "title": "Enable keep-awake",
      "effects": "write",
      "execution": {
        "mode": "handoff",
        "requiresForeground": true,
        "cancellation": "none",
        "idempotency": "none",
        "reconciliation": "none"
      },
      "receipts": {
        "success": "Enable keep-awake request handed to Caffeine. Its resulting state is not verified."
      },
      "binding": {
        "kind": "android.intent",
        "action": "android.intent.action.VIEW",
        "package": "moe.zhs.caffeine",
        "class": "moe.zhs.caffeine.ToggleActivity",
        "extras": {
          "Status": {
            "type": "integer",
            "value": 1
          }
        }
      }
    },
    {
      "tool": {
        "name": "disable",
        "description": "Ask Caffeine to stop keeping the screen awake. Uses the installed Caffeine app. State cannot be read back; a successful launch is handoff evidence only.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      },
      "title": "Disable keep-awake",
      "effects": "write",
      "execution": {
        "mode": "handoff",
        "requiresForeground": true,
        "cancellation": "none",
        "idempotency": "none",
        "reconciliation": "none"
      },
      "receipts": {
        "success": "Disable keep-awake request handed to Caffeine. Its resulting state is not verified."
      },
      "binding": {
        "kind": "android.intent",
        "action": "android.intent.action.VIEW",
        "package": "moe.zhs.caffeine",
        "class": "moe.zhs.caffeine.ToggleActivity",
        "extras": {
          "Status": {
            "type": "integer",
            "value": 0
          }
        }
      }
    }
  ]
}
